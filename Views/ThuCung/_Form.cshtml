@model ThuCung
<div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
<div class="row g-3">
    <div class="col-md-6">
        <label asp-for="MaTaiKhoan" class="form-label">Mã tài khoản</label>
        <input asp-for="MaTaiKhoan" class="form-control" />
        <span asp-validation-for="MaTaiKhoan" class="text-danger"></span>
    </div>
    <div class="col-md-6">
        <label asp-for="HoTen" class="form-label">Họ tên</label>
        <input asp-for="HoTen" class="form-control" />
        <span asp-validation-for="HoTen" class="text-danger"></span>
    </div>
    <div class="col-md-4">
        <label asp-for="NgaySinh" class="form-label">Ngày sinh</label>
        <input asp-for="NgaySinh" type="date" class="form-control" />
        <span asp-validation-for="NgaySinh" class="text-danger"></span>
    </div>
    <div class="col-md-4">
        <label asp-for="GioiTinh" class="form-label">Giới tính</label>
        <select asp-for="GioiTinh" class="form-select">
            <option>Đực</option>
            <option>Cái</option>
            <option>Khác</option>
        </select>
        <span asp-validation-for="GioiTinh" class="text-danger"></span>
    </div>
    <div class="col-md-4">
        <label class="form-label">Tuổi</label>
        <input value="@Model.Tuoi" class="form-control" readonly />
        <div class="form-text">Tuổi được tự tính từ ngày sinh.</div>
    </div>
    <div class="col-md-6">
        <label asp-for="SoDienThoai" class="form-label">Số điện thoại</label>
        <input asp-for="SoDienThoai" class="form-control" />
        <span asp-validation-for="SoDienThoai" class="text-danger"></span>
    </div>
    <div class="col-md-6">
        <label asp-for="Email" class="form-label">Email</label>
        <input asp-for="Email" class="form-control" />
        <span asp-validation-for="Email" class="text-danger"></span>
    </div>
    <div class="col-md-6">
        <label asp-for="DiaChi" class="form-label">Địa chỉ</label>
        <input asp-for="DiaChi" class="form-control" />
        <span asp-validation-for="DiaChi" class="text-danger"></span>
    </div>
    <div class="col-md-6">
        <label asp-for="GiongLoai" class="form-label">Giống/loài</label>
        <input asp-for="GiongLoai" class="form-control" placeholder="Ví dụ: Chó, Mèo, Chim..." />
        <span asp-validation-for="GiongLoai" class="text-danger"></span>
    </div>
    <div class="col-md-12">
        <label asp-for="GhiChuSucKhoe" class="form-label">Ghi chú sức khỏe</label>
        <textarea asp-for="GhiChuSucKhoe" class="form-control" rows="3"></textarea>
        <span asp-validation-for="GhiChuSucKhoe" class="text-danger"></span>
    </div>
    <div class="col-md-6">
        <label asp-for="TrangThai" class="form-label">Trạng thái</label>
        <select asp-for="TrangThai" class="form-select">
            <option>Hoạt động</option>
            <option>Ngừng hoạt động</option>
        </select>
        <span asp-validation-for="TrangThai" class="text-danger"></span>
    </div>
</div>
