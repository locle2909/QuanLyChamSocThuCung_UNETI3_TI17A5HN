@model QuanLyChamSocThuCung_UNETI3_TI17A5HN.Models.DichVu
@{
    ViewData["Title"] = "Thêm dịch vụ";
}

<h1 class="h3 mb-3">Thêm dịch vụ</h1>
<form asp-action="Create" method="post">
    <partial name="_FormFields" model="Model" />
