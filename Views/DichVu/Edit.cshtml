@model QuanLyChamSocThuCung_UNETI3_TI17A5HN.Models.DichVu
@{
    ViewData["Title"] = "Sửa dịch vụ";
}

<h1 class="h3 mb-3">Sửa dịch vụ</h1>
<form asp-action="Edit" asp-route-id="@Model.MaDichVu" method="post">
    <input asp-for="MaDichVu" type="hidden" />
    <partial name="_FormFields" model="Model" />
    <button type="submit" class="btn btn-primary">Lưu thay đổi</button>
    <a asp-action="Index" class="btn btn-outline-secondary">Hủy</a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}