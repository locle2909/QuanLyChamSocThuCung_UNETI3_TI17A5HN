@using Microsoft.AspNetCore.Http
@model IEnumerable<QuanLyChamSocThuCung_UNETI3_TI17A5HN.Models.DichVu>
@inject IHttpContextAccessor Accessor
@{
    ViewData["Title"] = "Dịch vụ";
    var isAdmin = Accessor.HttpContext?.Session.GetString(QuanLyChamSocThuCung_UNETI3_TI17A5HN.Models.HangSo.SessionKey.VaiTro)
        == QuanLyChamSocThuCung_UNETI3_TI17A5HN.Models.HangSo.VaiTro.Admin;
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Dịch vụ</h1>
    @if (isAdmin)
    {
        <a asp-action="Create" class="btn btn-primary">Thêm dịch vụ</a>
    }
</div>
@if (TempData["ThongBao"] is string thongBao)
{
    <div class="alert alert-success" role="status">@thongBao</div>
}
<div class="table-responsive">
    <table class="table table-striped align-middle">
        <thead>
            <tr>
                <th>Tên dịch vụ</th>
                <th>Nhóm</th>
                <th class="text-end">Giá</th>
                <th>Trạng thái</th>
                @if (isAdmin) { <th class="text-end">Thao tác</th> }
            </tr>
        </thead>
        <tbody>
            @foreach (var dichVu in Model)
            {
                <tr>
                    <td>
                        <strong>@dichVu.TenDichVu</strong>
                        @if (!string.IsNullOrWhiteSpace(dichVu.MoTa))
                        {
                            <div class="small text-muted">@dichVu.MoTa</div>
                        }
                    </td>
                    <td>@dichVu.NhomDichVu</td>
                    <td class="text-end">@dichVu.Gia.ToString("N0") đ</td>
                    <td>@dichVu.TrangThai</td>
                    @if (isAdmin)
                    {
                        <td class="text-end text-nowrap">
                            <a asp-action="Edit" asp-route-id="@dichVu.MaDichVu" class="btn btn-sm btn-outline-primary">Sửa</a>
                            @if (dichVu.TrangThai != QuanLyChamSocThuCung_UNETI3_TI17A5HN.Models.HangSo.TrangThaiDichVu.NgungPhucVu)
                            {
                                <form asp-action="Ngung" asp-route-id="@dichVu.MaDichVu" method="post" class="d-inline">
                                    <button type="submit" class="btn btn-sm btn-outline-danger">Ngừng</button>
                                </form>
                            }
                        </td>
                    }
                </tr>
            }
            @if (!Model.Any())
            {
                <tr><td colspan="5" class="text-center text-muted py-4">Chưa có dịch vụ.</td></tr>
            }
        </tbody>
    </table>
</div>