@* Họ và tên: Lê Hữu Lộc
   Mã sinh viên: 23103100283
   Nội dung thực hiện: Thông báo liên kết đặt lại mật khẩu không hợp lệ, đã hết hạn hoặc đã dùng. *@
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Liên kết không hợp lệ - PetCare</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <style>
        body { min-height: 100vh; margin: 0; background: #f8fafc; font-family: "Segoe UI", system-ui, sans-serif; }
        .wrap { min-height: 100vh; display: flex; align-items: center; justify-content: center; padding: 2rem; }
        .card-pc { width: 100%; max-width: 420px; background: #fff; border-radius: 1rem; padding: 2.25rem 2rem; box-shadow: 0 10px 30px rgba(15,23,42,.08); text-align: center; }
        .btn-pc { background: #0f766e; border-color: #0f766e; color: #fff; padding: .7rem; border-radius: .5rem; font-weight: 600; }
        .btn-pc:hover { background: #115e59; border-color: #115e59; color: #fff; }
    </style>
</head>
<body>
    <div class="wrap">
        <div class="card-pc">
            <h3 class="mb-2">Liên kết không hợp lệ</h3>
            <p class="text-muted mb-4">Liên kết đặt lại mật khẩu này không đúng, đã hết hạn (quá 15 phút) hoặc đã được sử dụng. Vui lòng yêu cầu liên kết mới.</p>
            <a asp-action="QuenMatKhau" class="btn btn-pc w-100 mb-2">Yêu cầu liên kết mới</a>
            <a asp-action="DangNhap" class="small">Quay lại đăng nhập</a>
        </div>
    </div>
</body>
</html>