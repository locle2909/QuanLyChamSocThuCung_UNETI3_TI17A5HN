@model QuanLyChamSocThuCung_UNETI3_TI17A5HN.Models.KetQuaDichVu

@{
    ViewData["Title"] = "Sửa kết quả dịch vụ";
    bool caDaHoanThanh = ViewBag.CaDaHoanThanh == true;
    bool khoaTrangThai = ViewBag.KhoaTrangThai == true;
}

<h2>Sửa kết quả dịch vụ</h2>

@if (caDaHoanThanh)
{
    <div class="alert alert-warning">
        Ca đã hoàn thành. Chỉ Admin được sửa, chỉ sửa được ghi chú (không đổi trạng thái kết quả)
        và bắt buộc ghi lý do vào ghi chú nội bộ. Lần sửa sẽ được lưu trong lịch sử.
    </div>
}
else if (khoaTrangThai)
{
    <div class="alert alert-info">
        Kết quả đã được đề xuất hoàn thành hoặc đã được khách hàng xác nhận nên không đổi được trạng thái.
        Bạn vẫn sửa được ghi chú.
    </div>
}

<p>
    <strong>Khách hàng:</strong> @ViewBag.TenKhachHang |
    <strong>Dịch vụ:</strong> @ViewBag.TenDichVu |
    <strong>Thú cưng:</strong> @ViewBag.TenThuCung
</p>

<form asp-action="Edit" asp-route-id="@Model.MaKetQuaDichVu" method="post">
    @Html.AntiForgeryToken()
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    <div class="mb-3">
        <label asp-for="TrangThaiKetQuaDichVu" class="form-label">Trạng thái kết quả</label>
        @if (khoaTrangThai)
        {
            <input class="form-control" value="@Model.TrangThaiKetQuaDichVu" disabled />
        }
        else
        {
            <select asp-for="TrangThaiKetQuaDichVu" class="form-select">
                <option value="Chờ thực hiện">Chờ thực hiện</option>
                <option value="Đang thực hiện">Đang thực hiện</option>
            </select>
            <div class="form-text">
                Khi thực hiện xong, hãy dùng nút "Đề xuất hoàn thành" ở trang danh sách.
                Kết quả chỉ chuyển sang Hoàn thành khi khách hàng xác nhận.
            </div>
        }
        <span asp-validation-for="TrangThaiKetQuaDichVu" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="GhiChu" class="form-label">Ghi chú cho khách hàng (khách hàng sẽ thấy)</label>
        <textarea asp-for="GhiChu" class="form-control"></textarea>
        <span asp-validation-for="GhiChu" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="GhiChuNoiBo" class="form-label">
            Ghi chú nội bộ (khách hàng không thấy) @(caDaHoanThanh ? "- bắt buộc ghi lý do sửa" : "")
        </label>
        <textarea asp-for="GhiChuNoiBo" class="form-control"></textarea>
        <span asp-validation-for="GhiChuNoiBo" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-primary">Cập nhật</button>
    <a asp-action="Index" class="btn btn-secondary">Quay lại</a>
</form>