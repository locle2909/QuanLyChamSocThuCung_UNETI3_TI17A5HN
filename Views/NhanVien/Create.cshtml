@model QuanLyChamSocThuCung_UNETI3_TI17A5HN.Models.NhanVien

@{
    ViewData["Title"] = "Thêm nhân viên";
    var danhSachChuyenMon = ViewBag.DanhSachChuyenMon as List<string> ?? new List<string>();
    var daChon = ViewBag.DaChon as List<string> ?? new List<string>();
    var dsTaiKhoan = ViewBag.DsTaiKhoan as List<TaiKhoan> ?? new();
}

<h2>Thêm nhân viên</h2>

<form asp-action="Create" method="post">
    @Html.AntiForgeryToken()

    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    <div class="mb-3">
        <label asp-for="HoTen" class="form-label">Họ tên</label>
        <input asp-for="HoTen" class="form-control" />
        <span asp-validation-for="HoTen" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="SoDienThoai" class="form-label">Số điện thoại</label>
        <input asp-for="SoDienThoai" class="form-control" />
        <span asp-validation-for="SoDienThoai" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Email" class="form-label">Email</label>
        <input asp-for="Email" class="form-control" />
        <span asp-validation-for="Email" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="MaTaiKhoan" class="form-label">Tài khoản đăng nhập (vai trò Nhân viên)</label>
        <select asp-for="MaTaiKhoan" class="form-select">
            <option value="">-- Chưa liên kết --</option>
            @foreach (var tk in dsTaiKhoan)
            {
                <option value="@tk.MaTaiKhoan">@tk.HoTen (@tk.TenDangNhap)</option>
            }
        </select>
        <span asp-validation-for="MaTaiKhoan" class="text-danger"></span>
        <div class="form-text">Nhân viên chỉ ghi được kết quả dịch vụ khi đã liên kết tài khoản.</div>
    </div>

    <div class="mb-3">
        <label class="form-label">Chuyên môn</label>
        <select name="tenChuyenMons" class="form-select" multiple size="4">
            @foreach (var cm in danhSachChuyenMon)
            {
                <option value="@cm" selected="@daChon.Contains(cm)">@cm</option>
            }
        </select>
        <small class="text-muted">Giữ phím Ctrl để chọn nhiều chuyên môn.</small>
        <span class="text-danger">@Html.ValidationMessage("tenChuyenMons")</span>
    </div>

    <div class="form-check mb-3">
        <input asp-for="TrangThai" class="form-check-input" />
        <label asp-for="TrangThai" class="form-check-label">Đang hoạt động</label>
    </div>

    <button type="submit" class="btn btn-primary">Lưu</button>
    <a asp-action="Index" class="btn btn-secondary">Quay lại</a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}