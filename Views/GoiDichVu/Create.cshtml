@model QuanLyChamSocThuCung_UNETI3_TI17A5HN.ViewModels.GoiDichVuFormViewModel
@{
    ViewData["Title"] = "Thêm gói dịch vụ";
}

<h1 class="h3 mb-3">Thêm gói dịch vụ</h1>
<form asp-action="Create" method="post">
    <partial name="_Form" model="Model" />
    <button type="submit" class="btn btn-primary">Lưu gói</button>
    <a asp-action="Index" class="btn btn-outline-secondary">Hủy</a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}