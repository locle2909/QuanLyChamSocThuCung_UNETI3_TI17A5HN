@* Họ và tên: Lê Hữu Lộc
   Mã sinh viên: 23103100283
   Nội dung thực hiện: Danh sách loại dịch vụ (Admin): tìm kiếm không tải lại trang, lọc, sắp xếp, phân trang, AJAX, xuất Excel, biểu đồ Chart.js. *@
@model IEnumerable<LoaiDichVu>
@{
    ViewData["Title"] = "Loại dịch vụ";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h3 class="mb-0">Loại dịch vụ</h3>
    <div>
        <a id="nutExcel" href="/LoaiDichVu/XuatExcel" class="btn btn-outline-success">Xuất Excel</a>
        <a asp-action="Create" class="btn btn-primary">+ Thêm loại dịch vụ</a>
    </div>
</div>

@if (TempData["ThongBao"] != null)
{
    <div class="alert alert-success">@TempData["ThongBao"]</div>
}
@if (TempData["Loi"] != null)
{
    <div class="alert alert-danger">@TempData["Loi"]</div>
}
<div id="thongBaoAjax"></div>

<div class="row mb-4">
    <div class="col-md-7"><div style="height:260px"><canvas id="bieuDoNhom"></canvas></div></div>
    <div class="col-md-5"><div style="height:260px"><canvas id="bieuDoTrangThai"></canvas></div></div>
</div>

<form id="formLoc" method="get" class="row g-2 mb-3">
    <div class="col-md-4">
        <input name="q" value="@ViewBag.Q" class="form-control" placeholder="Tìm theo tên loại dịch vụ..." autocomplete="off" />
    </div>
    <div class="col-md-3">
        <select name="nhom" class="form-select" asp-items="(SelectList)ViewBag.DsNhom">
            <option value="">-- Tất cả nhóm --</option>
        </select>
    </div>
    <div class="col-md-3">
        <select name="sapXep" class="form-select">
            <option value="">Mặc định (theo nhóm)</option>
            <option value="ten_tang" selected="@((string?)ViewBag.SapXep == "ten_tang")">Tên A → Z</option>
            <option value="ten_giam" selected="@((string?)ViewBag.SapXep == "ten_giam")">Tên Z → A</option>
        </select>
    </div>
    <div class="col-auto">
        <a asp-action="Index" class="btn btn-outline-secondary">Xóa lọc</a>
    </div>
</form>

<div id="vungDanhSach">
    <partial name="_DanhSach" model="Model" />
</div>

<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>
<script src="~/js/loaidichvu.js"></script>