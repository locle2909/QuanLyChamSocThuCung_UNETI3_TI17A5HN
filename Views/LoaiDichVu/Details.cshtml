@* Họ và tên: Lê Hữu Lộc
   Mã sinh viên: 23103100283
   Nội dung thực hiện: Chi tiết loại dịch vụ (Admin). *@
@model LoaiDichVu
@{
    ViewData["Title"] = "Chi tiết loại dịch vụ";
}

<h3 class="mb-3">Chi tiết loại dịch vụ</h3>

<dl class="row">
    <dt class="col-sm-3">Tên loại dịch vụ</dt>
    <dd class="col-sm-9">@Model.TenLoaiDichVu</dd>

    <dt class="col-sm-3">Nhóm dịch vụ</dt>
    <dd class="col-sm-9">@Model.NhomDichVu</dd>

    <dt class="col-sm-3">Mô tả</dt>
    <dd class="col-sm-9" style="white-space:pre-line">@Model.MoTa</dd>

    <dt class="col-sm-3">Trạng thái</dt>
    <dd class="col-sm-9">@(Model.TrangThai ? "Hoạt động" : "Đã tắt")</dd>

    <dt class="col-sm-3">Đang được sử dụng</dt>
    <dd class="col-sm-9">@ViewBag.SoDangDung bản ghi</dd>
</dl>

<a asp-action="Edit" asp-route-id="@Model.MaLoaiDichVu" class="btn btn-primary">Sửa</a>
<a asp-action="Index" class="btn btn-outline-secondary">Quay lại</a>