@* Họ và tên: Lê Hữu Lộc
   Mã sinh viên: 23103100283
   Nội dung thực hiện: Phần chung nhóm trưởng: menu điều hướng theo vai trò. *@
@using Microsoft.AspNetCore.Http
@using QuanLyChamSocThuCung_UNETI3_TI17A5HN.Models
@inject IHttpContextAccessor Accessor
@{
    var session = Accessor.HttpContext?.Session;
    var vaiTro = session?.GetString(HangSo.SessionKey.VaiTro);
    var hoTen = session?.GetString(HangSo.SessionKey.HoTen);
}
<ul class="navbar-nav flex-grow-1">
    @if (vaiTro == HangSo.VaiTro.Admin)
    {
        <li class="nav-item"><a class="nav-link" asp-controller="TaiKhoan" asp-action="Index">Tài khoản</a></li>
        <li class="nav-item"><a class="nav-link" asp-controller="LoaiDichVu" asp-action="Index">Loại dịch vụ</a></li>
        <li class="nav-item"><a class="nav-link" asp-controller="ThuCung" asp-action="Index">Thú cưng</a></li>
        <li class="nav-item"><a class="nav-link" asp-controller="KhachHang" asp-action="Index">Khách hàng</a></li>
        <li class="nav-item"><a class="nav-link" asp-controller="DichVu" asp-action="Index">Dịch vụ</a></li>
        <li class="nav-item"><a class="nav-link" asp-controller="LichHen" asp-action="Index">Lịch hẹn</a></li>
        <li class="nav-item"><a class="nav-link" asp-controller="PhanCongNhanVien" asp-action="Index">Phân công</a></li>
        <li class="nav-item"><a class="nav-link" asp-controller="CaDichVu" asp-action="Index">Ca dịch vụ</a></li>
        <li class="nav-item"><a class="nav-link" asp-controller="KetQuaDichVu" asp-action="Index">Kết quả</a></li>
        <li class="nav-item"><a class="nav-link" asp-controller="ThanhToan" asp-action="Index">Thanh toán</a></li>
        <li class="nav-item"><a class="nav-link" asp-controller="ThongKe" asp-action="Index">Thống kê</a></li>
    }
    else if (vaiTro == HangSo.VaiTro.NhanVien)
    {
        <li class="nav-item"><a class="nav-link" asp-controller="PhanCongNhanVien" asp-action="Index">Phân công</a></li>
        <li class="nav-item"><a class="nav-link" asp-controller="CaDichVu" asp-action="Index">Ca dịch vụ</a></li>
        <li class="nav-item"><a class="nav-link" asp-controller="KetQuaDichVu" asp-action="Index">Kết quả</a></li>
    }
    else if (vaiTro == HangSo.VaiTro.KhachHang)
    {
        <li class="nav-item"><a class="nav-link" asp-controller="DichVu" asp-action="Index">Dịch vụ</a></li>
        <li class="nav-item"><a class="nav-link" asp-controller="GoiDichVu" asp-action="Index">Gói dịch vụ</a></li>
        <li class="nav-item"><a class="nav-link" asp-controller="LichHen" asp-action="Index">Lịch hẹn của tôi</a></li>
        <li class="nav-item"><a class="nav-link" asp-controller="ThanhToan" asp-action="Index">Chi phí</a></li>
    }
</ul>
<ul class="navbar-nav">
    @if (vaiTro != null)
    {
        <li class="nav-item"><span class="nav-link">@hoTen (@HangSo.VaiTro.Ten(vaiTro))</span></li>
        <li class="nav-item"><a class="nav-link" asp-controller="TaiKhoan" asp-action="DangXuat">Đăng xuất</a></li>
    }
    else
    {
        <li class="nav-item"><a class="nav-link" asp-controller="TaiKhoan" asp-action="DangNhap">Đăng nhập</a></li>
    }
</ul>
