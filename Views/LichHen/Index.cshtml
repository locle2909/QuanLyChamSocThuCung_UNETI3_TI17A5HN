@model IEnumerable<LichHenIndexItemViewModel>

@{
    ViewData["Title"] = "Lịch hẹn";
    var vaiTro = (string)ViewBag.VaiTro;
    var laKhachHang = vaiTro == HangSo.VaiTro.KhachHang;
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
    <h2 class="mb-0">@(laKhachHang ? "Lịch hẹn của tôi" : "Quản lý lịch hẹn")</h2>
    @if (laKhachHang)
    {
        <a asp-action="Create" class="btn btn-primary">Đặt lịch mới</a>
    }
</div>

@if (TempData["ThongBao"] is string thongBao)
{
    <div class="alert alert-success">@thongBao</div>
}
@if (TempData["Loi"] is string loi)
{
    <div class="alert alert-warning">@loi</div>
}

<form asp-action="Index" method="get" class="row g-2 align-items-end mb-3">
    <div class="col-sm-5 col-md-4">
        <label for="trangThai" class="form-label">Lọc theo trạng thái</label>
        <select id="trangThai" name="trangThai" asp-items="ViewBag.DanhSachTrangThai" class="form-select">
            <option value="">Tất cả trạng thái</option>
        </select>
    </div>
    <div class="col-auto">
        <button type="submit" class="btn btn-outline-primary">Lọc</button>
        <a asp-action="Index" class="btn btn-outline-secondary">Xóa lọc</a>
    </div>
</form>

<div class="table-responsive">
    <table class="table table-bordered table-striped align-middle">
        <thead>
            <tr>
                <th>Mã lịch</th>
                @if (!laKhachHang)
                {
                    <th>Khách hàng</th>
                }
                <th>Thú cưng</th>
                <th>Dịch vụ</th>
                <th>Bắt đầu</th>
                <th>Kết thúc</th>
                <th>Trạng thái</th>
                <th>Ghi chú</th>
                <th>Thao tác</th>
            </tr>
        </thead>
        <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.MaLichHen</td>
                @if (!laKhachHang)
                {
                    <td>@item.TenKhachHang</td>
                }
                <td>@item.TenThuCung</td>
                <td>@item.TenDichVu</td>
                <td>@item.ThoiGianBatDau.ToString("dd/MM/yyyy HH:mm")</td>
                <td>@item.ThoiGianKetThuc.ToString("dd/MM/yyyy HH:mm")</td>
                <td>@item.TrangThai</td>
                <td>@item.GhiChu</td>
                <td class="text-nowrap">
                    @if (item.CoTheXacNhan && !laKhachHang)
                    {
                        <form asp-action="XacNhan" asp-route-id="@item.MaLichHen" method="post" class="d-inline">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-sm btn-success">Xác nhận</button>
                        </form>
                    }
                    @if (item.CoTheHoanThanh && !laKhachHang)
                    {
                        <form asp-action="HoanThanh" asp-route-id="@item.MaLichHen" method="post" class="d-inline">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-sm btn-primary">Hoàn tất</button>
                        </form>
                    }
                    @if (item.CoTheHuy)
                    {
                        <form asp-action="Huy" asp-route-id="@item.MaLichHen" method="post" class="d-inline"
                              onsubmit="return confirm('Bạn có chắc muốn hủy lịch hẹn này?');">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-sm btn-danger">Hủy</button>
                        </form>
                    }
                    @if (!item.CoTheXacNhan && !item.CoTheHoanThanh && !item.CoTheHuy)
                    {
                        <span class="text-muted">Không có</span>
                    }
                </td>
            </tr>
        }
        @if (!Model.Any())
        {
            <tr>
                <td colspan="@(laKhachHang ? 8 : 9)" class="text-center text-muted py-4">Chưa có lịch hẹn phù hợp.</td>
            </tr>
        }
        </tbody>
    </table>
</div>
