@* Họ và tên: Lê Hữu Lộc
   Mã sinh viên: 23103100283
   Nội dung thực hiện: SV5 - Dashboard tổng quan cho Admin: số liệu nhanh và tiền thu theo kỳ. *@
@using QuanLyChamSocThuCung_UNETI3_TI17A5HN.Helpers
@model DashboardViewModel
@{
    ViewData["Title"] = "Dashboard";
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
    <h3 class="mb-0">Dashboard</h3>
    <a asp-action="Index" class="btn btn-outline-primary">Xem thống kê chi tiết</a>
</div>

@if (TempData["Loi"] is string loi)
{
    <div class="alert alert-warning">@loi</div>
}

<form asp-action="Dashboard" method="get" class="row g-2 align-items-end mb-4">
    <div class="col-sm-4 col-md-3">
        <label class="form-label" for="tuNgay">Từ ngày</label>
        <input id="tuNgay" name="tuNgay" type="date" value="@Model.TuNgay.ToString("yyyy-MM-dd")" class="form-control" />
    </div>
    <div class="col-sm-4 col-md-3">
        <label class="form-label" for="denNgay">Đến ngày</label>
        <input id="denNgay" name="denNgay" type="date" value="@Model.DenNgay.ToString("yyyy-MM-dd")" class="form-control" />
    </div>
    <div class="col-auto">
        <button type="submit" class="btn btn-outline-primary">Xem</button>
    </div>
</form>

@{
    void The(string nhan, string giaTri, string mau = "primary")
    {
        <div class="col-6 col-lg-3">
            <div class="@("card h-100 border-" + mau)">
                <div class="card-body">
                    <div class="text-muted small">@nhan</div>
                    <div class="fs-3 fw-bold">@giaTri</div>
                </div>
            </div>
        </div>
    }
}

<div class="row g-3 mb-4">
    @{ The("Tiền thu trong kỳ", Model.TongThuTrongKy.ToVnd(), "success"); }
    @{ The("Lịch hẹn còn thiếu chi phí", Model.LichHenConThieuChiPhi.ToString(), "danger"); }
    @{ The("Lịch hẹn chờ xác nhận", Model.LichHenChoXacNhan.ToString(), "warning"); }
    @{ The("Ca dịch vụ sắp tới", Model.CaDichVuSapToi.ToString()); }
</div>

<div class="row g-3">
    @{ The("Loại dịch vụ", Model.TongLoaiDichVu.ToString(), "secondary"); }
    @{ The("Thú cưng đang hoạt động", Model.TongThuCungHoatDong.ToString(), "secondary"); }
    @{ The("Khách hàng", Model.TongKhachHang.ToString(), "secondary"); }
    @{ The("Gói dịch vụ", Model.TongGoiDichVu.ToString(), "secondary"); }
    @{ The("Tổng dịch vụ", Model.TongDichVu.ToString(), "secondary"); }
    @{ The("Đang mở đăng ký", Model.DichVuDangMoDangKy.ToString(), "secondary"); }
    @{ The("Đang phục vụ", Model.DichVuDangPhucVu.ToString(), "secondary"); }
    @{ The("Đã đủ", Model.DichVuDaDu.ToString(), "secondary"); }
</div>
