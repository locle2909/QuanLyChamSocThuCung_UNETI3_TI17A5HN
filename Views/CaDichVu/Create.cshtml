@model QuanLyChamSocThuCung_UNETI3_TI17A5HN.Models.CaDichVu

@{
    ViewData["Title"] = "Tạo ca dịch vụ";
    var dichVus = ViewBag.DichVus as List<DichVu> ?? new();
    var thuCungs = ViewBag.ThuCungs as List<ThuCung> ?? new();
}

<h2>Tạo ca dịch vụ</h2>

<form asp-action="Create" method="post">
    @Html.AntiForgeryToken()
    <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

    <div class="mb-3">
        <label asp-for="MaDichVu" class="form-label">Dịch vụ</label>
        <select asp-for="MaDichVu" class="form-select">
            <option value="">-- Chọn dịch vụ --</option>
            @foreach (var dv in dichVus)
            {
                <option value="@dv.MaDichVu">@dv.TenDichVu (@dv.NhomDichVu)</option>
            }
        </select>
        <span asp-validation-for="MaDichVu" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="MaThuCung" class="form-label">Thú cưng</label>
        <select asp-for="MaThuCung" class="form-select">
            <option value="">-- Chọn thú cưng --</option>
            @foreach (var tc in thuCungs)
            {
                <option value="@tc.MaThuCung">@tc.HoTen (@tc.GiongLoai)</option>
            }
        </select>
        <span asp-validation-for="MaThuCung" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="ThoiGianBatDau" class="form-label">Thời gian bắt đầu</label>
        <input asp-for="ThoiGianBatDau" type="datetime-local" asp-format="{0:yyyy-MM-ddTHH:mm}" class="form-control" />
        <span asp-validation-for="ThoiGianBatDau" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="ThoiGianKetThuc" class="form-label">Thời gian kết thúc</label>
        <input asp-for="ThoiGianKetThuc" type="datetime-local" asp-format="{0:yyyy-MM-ddTHH:mm}" class="form-control" />
        <span asp-validation-for="ThoiGianKetThuc" class="text-danger"></span>
        <div class="form-text">Ca thường nằm trong 07:00 - 21:00 cùng một ngày (dịch vụ lưu trú được nhiều ngày).</div>
    </div>

    <div class="mb-3">
        <label asp-for="PhongHocHoacHinhThuc" class="form-label">Phòng / hình thức</label>
        <input asp-for="PhongHocHoacHinhThuc" class="form-control" list="dsPhong" />
        <datalist id="dsPhong">
            <option value="Phòng 1"></option>
            <option value="Phòng 2"></option>
            <option value="Phòng 3"></option>
            <option value="Tại nhà"></option>
        </datalist>
        <span asp-validation-for="PhongHocHoacHinhThuc" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="GhiChu" class="form-label">Ghi chú</label>
        <textarea asp-for="GhiChu" class="form-control"></textarea>
    </div>

    <button type="submit" class="btn btn-primary">Lưu ca</button>
    <a asp-action="Index" class="btn btn-secondary">Quay lại</a>
</form>