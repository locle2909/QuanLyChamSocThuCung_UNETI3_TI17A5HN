@model IEnumerable<QuanLyChamSocThuCung_UNETI3_TI17A5HN.Controllers.KetQuaHienThi>

@{
    ViewData["Title"] = "Kết quả dịch vụ của tôi";
}

<h2>Kết quả dịch vụ của tôi</h2>

@if (TempData["ThongBao"] != null)
{
    <div class="alert alert-success">@TempData["ThongBao"]</div>
}
@if (TempData["Loi"] != null)
{
    <div class="alert alert-warning">@TempData["Loi"]</div>
}

<form method="get" asp-action="Index" class="card card-body mb-3">
    <div class="row g-2 align-items-end">
        <div class="col-md-4">
            <label class="form-label">Tìm kiếm</label>
            <input name="tuKhoa" value="@ViewBag.TuKhoa" class="form-control"
                   placeholder="Mã kết quả, mã ca, dịch vụ, thú cưng..." />
        </div>
        <div class="col-md-3">
            <label class="form-label">Trạng thái</label>
            <select name="trangThai" class="form-select">
                <option value="">Tất cả trạng thái</option>
                <option value="Chờ thực hiện" selected="@((string?)ViewBag.TrangThai == "Chờ thực hiện")">Chờ thực hiện</option>
                <option value="Đang thực hiện" selected="@((string?)ViewBag.TrangThai == "Đang thực hiện")">Đang thực hiện</option>
                <option value="Chờ khách xác nhận" selected="@((string?)ViewBag.TrangThai == "Chờ khách xác nhận")">Chờ khách xác nhận</option>
                <option value="Hoàn thành" selected="@((string?)ViewBag.TrangThai == "Hoàn thành")">Hoàn thành</option>
            </select>
        </div>
        <div class="col-md-2">
            <label class="form-label">Từ ngày</label>
            <input type="date" name="tuNgay" value="@ViewBag.TuNgay" class="form-control" />
        </div>
        <div class="col-md-2">
            <label class="form-label">Đến ngày</label>
            <input type="date" name="denNgay" value="@ViewBag.DenNgay" class="form-control" />
        </div>
        <div class="col-md-1 d-grid">
            <button type="submit" class="btn btn-primary">Tìm</button>
        </div>
    </div>
    <div class="mt-2"><a asp-action="Index" class="btn btn-sm btn-outline-secondary">Đặt lại bộ lọc</a></div>
</form>

@if (!Model.Any())
{
    <div class="alert alert-info">Không tìm thấy kết quả dịch vụ phù hợp.</div>
}
else
{
    <div class="table-responsive">
        <table class="table table-bordered table-striped align-middle">
            <thead>
                <tr>
                    <th>Dịch vụ</th>
                    <th>Thú cưng</th>
                    <th>Thời gian ca</th>
                    <th>Trạng thái ca</th>
                    <th>Kết quả</th>
                    <th>Cập nhật lúc</th>
                    <th>Ghi chú</th>
                    <th>Xác nhận</th>
                </tr>
            </thead>
            <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.TenDichVu</td>
                    <td>@item.TenThuCung</td>
                    <td>@item.ThoiGianBatDau.ToString("dd/MM/yyyy HH:mm")</td>
                    <td>@item.TrangThaiCa</td>
                    <td>
                        @if (item.TrangThai == HangSo.TrangThaiKetQua.HoanThanh)
                        {
                            <span class="badge bg-success">Hoàn thành</span>
                        }
                        else if (item.TrangThai == HangSo.TrangThaiKetQua.ChoKhachXacNhan)
                        {
                            <span class="badge bg-warning text-dark">Chờ bạn xác nhận</span>
                        }
                        else if (item.TrangThai == HangSo.TrangThaiKetQua.DangThucHien)
                        {
                            <span class="badge bg-primary">Đang thực hiện</span>
                        }
                        else
                        {
                            <span class="badge bg-secondary">@item.TrangThai</span>
                        }
                    </td>
                    <td>@item.ThoiGianGhiNhan.ToString("dd/MM/yyyy HH:mm")</td>
                    <td>@item.GhiChu</td>
                    <td style="min-width: 260px">
                        @if (item.ChoKhachXacNhan)
                        {
                            if (item.ThoiGianDeXuatHoanThanh != null)
                            {
                                <div class="mb-2">
                                    <small class="text-muted">
                                        Nhân viên đề xuất lúc @item.ThoiGianDeXuatHoanThanh.Value.ToString("dd/MM/yyyy HH:mm")
                                    </small>
                                </div>
                            }

                            <form asp-action="XacNhanHoanThanh" asp-route-id="@item.MaKetQuaDichVu" method="post" class="mb-2"
                                  onsubmit="return confirm('Bạn xác nhận dịch vụ đã hoàn thành?');">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-success btn-sm">Xác nhận hoàn thành</button>
                            </form>

                            <form asp-action="YeuCauLamLai" asp-route-id="@item.MaKetQuaDichVu" method="post">
                                @Html.AntiForgeryToken()
                                <input type="text" name="lyDo" class="form-control form-control-sm mb-1"
                                       maxlength="500" placeholder="Lý do chưa hài lòng" required />
                                <button type="submit" class="btn btn-outline-danger btn-sm">Chưa hài lòng, yêu cầu làm lại</button>
                            </form>
                        }
                        else if (item.TrangThai == HangSo.TrangThaiKetQua.HoanThanh)
                        {
                            <span class="text-success">Đã xác nhận</span>
                            if (item.ThoiGianKhachXacNhanHoanThanh != null)
                            {
                                <br />
                                <small class="text-muted">@item.ThoiGianKhachXacNhanHoanThanh.Value.ToString("dd/MM/yyyy HH:mm")</small>
                            }
                        }
                        else
                        {
                            <span class="text-muted">Chưa có yêu cầu xác nhận</span>
                        }
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
}