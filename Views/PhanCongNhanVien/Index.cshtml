
@model IEnumerable<QuanLyChamSocThuCung_UNETI3_TI17A5HN.Controllers.PhanCongHienThi>

@{
    ViewData["Title"] = "Phân công nhân viên";
}

<h2>Phân công nhân viên</h2>

@if (TempData["ThongBao"] != null)
{
    <div class="alert alert-info">@TempData["ThongBao"]</div>
}

<p>
    <a asp-action="Create" class="btn btn-primary">Phân công mới</a>
    <a asp-controller="NhanVien" asp-action="Index" class="btn btn-secondary">
        Nhân viên
    </a>
    <a asp-controller="CaDichVu" asp-action="Index" class="btn btn-secondary">
        Ca dịch vụ
    </a>
</p>

<table class="table table-bordered table-striped">
    <thead>
        <tr>
            <th>Mã phân công</th>
            <th>Nhân viên</th>
            <th>Mã ca</th>
            <th>Bắt đầu</th>
            <th>Kết thúc</th>
            <th>Trạng thái</th>
            <th>Ghi chú</th>
            <th>Thao tác</th>
        </tr>
    </thead>
    <tbody>
    @foreach (var pc in Model)
    {
        <tr>
            <td>@pc.MaPhanCong</td>
            <td>@pc.HoTenNhanVien (Mã: @pc.MaNhanVien)</td>
            <td>@pc.MaCaDichVu</td>
            <td>@pc.ThoiGianBatDau.ToString("dd/MM/yyyy HH:mm")</td>
            <td>@pc.ThoiGianKetThuc.ToString("dd/MM/yyyy HH:mm")</td>
            <td>@pc.TrangThai</td>
            <td>@pc.GhiChu</td>
            <td>
                @if (pc.TrangThai != "Đã hủy" &&
                     pc.TrangThai != "Hoàn thành")
                {
                    <form asp-action="Huy" asp-route-id="@pc.MaPhanCong"
                          method="post"
                          onsubmit="return confirm('Hủy phân công này?');">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-sm btn-danger">
                            Hủy
                        </button>
                    </form>
                }
            </td>
        </tr>
    }
    </tbody>
</table>