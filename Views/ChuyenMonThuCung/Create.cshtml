@model ChuyenMonThuCung
@{
    ViewData["Title"] = "Thêm thông tin chăm sóc";
}
<h1 class="h3 mb-3">Thêm thông tin chăm sóc</h1>
<form asp-action="Create" method="post">
    <partial name="_Form" model="Model" />
    <div class="mt-4"><button type="submit" class="btn btn-primary">Lưu</button> <a asp-action="Index" class="btn btn-secondary">Quay lại</a></div>
</form>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
