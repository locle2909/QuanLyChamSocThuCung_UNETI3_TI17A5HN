@model ChuyenMonThuCung
@{
    ViewData["Title"] = "Chi tiết chăm sóc";
}
<h1 class="h3 mb-3">Chi tiết thông tin chăm sóc</h1>
<div class="card"><div class="card-body"><dl class="row mb-0">
    <dt class="col-sm-3">Mã chuyên môn</dt><dd class="col-sm-9">@Model.MaChuyenMon</dd>
    <dt class="col-sm-3">Thú cưng</dt><dd class="col-sm-9">@Model.ThuCung?.HoTen</dd>
    <dt class="col-sm-3">Loại dịch vụ</dt><dd class="col-sm-9">@Model.LoaiDichVu?.TenLoaiDichVu</dd>
    <dt class="col-sm-3">Giống/loài chuyên môn</dt><dd class="col-sm-9">@Model.GiongLoaiChuyenMon</dd>
    <dt class="col-sm-3">Tuổi môn</dt><dd class="col-sm-9">@Model.TuoiMon</dd>
    <dt class="col-sm-3">Ghi chú</dt><dd class="col-sm-9">@Model.GhiChu</dd>
    <dt class="col-sm-3">Trạng thái</dt><dd class="col-sm-9">@Model.TrangThai</dd>
</dl></div></div>
<div class="mt-3"><a asp-action="Edit" asp-route-id="@Model.MaChuyenMon" class="btn btn-primary">Sửa</a> <a asp-action="Index" class="btn btn-secondary">Quay lại</a></div>
