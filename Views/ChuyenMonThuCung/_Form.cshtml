@model ChuyenMonThuCung
<div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
<div class="row g-3">
    <div class="col-md-6">
        <label asp-for="MaThuCung" class="form-label">Thú cưng</label>
        <select asp-for="MaThuCung" class="form-select">
            <option value="">-- Chọn thú cưng --</option>
            @foreach (var x in (List<ThuCung>)ViewBag.ThuCungs)
            {
                <option value="@x.MaThuCung">@x.HoTen - @x.GiongLoai - @x.Tuoi tuổi</option>
            }
        </select>
        <span asp-validation-for="MaThuCung" class="text-danger"></span>
    </div>
    <div class="col-md-6">
        <label asp-for="MaLoaiDichVu" class="form-label">Loại dịch vụ</label>
        <select asp-for="MaLoaiDichVu" class="form-select">
            <option value="">-- Chọn loại dịch vụ --</option>
            @foreach (var x in (List<LoaiDichVu>)ViewBag.LoaiDichVus)
            {
                <option value="@x.MaLoaiDichVu">@x.TenLoaiDichVu</option>
            }
        </select>
        <span asp-validation-for="MaLoaiDichVu" class="text-danger"></span>
    </div>
    <div class="col-md-4">
        <label asp-for="GiongLoaiChuyenMon" class="form-label">Giống/loài chuyên môn</label>
        <input asp-for="GiongLoaiChuyenMon" class="form-control" readonly />
        <div class="form-text">Tự lấy theo thú cưng.</div>
    </div>
    <div class="col-md-4">
        <label asp-for="TuoiMon" class="form-label">Tuổi môn</label>
        <input asp-for="TuoiMon" type="number" min="0" class="form-control" />
        <span asp-validation-for="TuoiMon" class="text-danger"></span>
    </div>
    <div class="col-md-4">
        <label asp-for="TrangThai" class="form-label">Trạng thái</label>
        <select asp-for="TrangThai" class="form-select">
            <option>Hiệu lực</option>
            <option>Hết hiệu lực</option>
        </select>
    </div>
    <div class="col-md-12">
        <label asp-for="GhiChu" class="form-label">Ghi chú</label>
        <textarea asp-for="GhiChu" class="form-control" rows="3"></textarea>
        <span asp-validation-for="GhiChu" class="text-danger"></span>
    </div>
</div>
